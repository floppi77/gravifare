config_version=5

[application]
config/name="GraviFare"
config/features=PackedStringArray("4.7")
run/main_scene="res://src/game/boot.tscn"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[physics]
common/physics_ticks_per_second=120
common/physics_interpolation=true

[rendering]
textures/canvas_textures/default_texture_filter=0

[autoload]

Controls="*res://src/core/controls.gd"
Loc="*res://src/core/loc.gd"
Sfx="*res://src/core/sfx.gd"
Settings="*res://src/core/settings.gd"
Save="*res://src/core/save.gd"
Flow="*res://src/core/flow.gd"
